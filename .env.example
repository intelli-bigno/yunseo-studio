# YS-Studio 환경 변수 예시 — scripts/setup.sh 가 이 파일을 .env 로 복사한다. .env 는 Git 에 올라가지 않는다.
# 이 프로젝트는 API 키·토큰·비밀번호가 필요 없다(이미지는 codex 로그인으로 만든다). 비밀값을 여기에 넣지 않는다.
# 값을 비워 두면 괄호 안의 기본값을 쓴다. 줄 끝에 설명(#)을 붙여도 된다.

# 대시보드 포트 (기본 8930). 주소는 항상 이 컴퓨터 안(127.0.0.1)에만 열린다 — 로그인이 없으므로 밖으로 열지 않는다.
PORT=8930

# 데이터 위치 — 덱·콘텐츠가 저장되는 SQLite 파일과 렌더 산출물 폴더. 비우면 저장소 안 .data/ 를 쓴다(.data/ 는 Git 제외).
STUDIO_DB=            # (기본 <저장소>/.data/studio.db)
STUDIO_WORK_DIR=      # (기본 <저장소>/.data/work)

# system = 오늘 날짜를 실제 시계(한국 시간)로. 비우면 시안 데이터용 고정 날짜를 쓰므로 실제로 쓸 때는 system 으로 둔다.
STUDIO_CLOCK=system

# 이력·검수 기록에 남는 이름 (기본 「운영자」)
STUDIO_OPERATOR=

# scripts/studio-cards.mjs 가 접속할 주소 (기본 http://127.0.0.1:<PORT>). 보통 비워 둔다.
STUDIO_URL=

# 릴스 합성용 ffmpeg 경로 — PATH 에 ffmpeg·ffprobe 가 있으면 비워 둔다.
FFMPEG_PATH=
FFPROBE_PATH=
